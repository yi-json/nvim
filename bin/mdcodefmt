#!/usr/bin/env python3
"""Format fenced code blocks inside markdown files in place.

Complements clang-format-docs, which only handles c/c++/json/c#/java fences.
This covers the remaining languages via their own formatter CLI, each read
from stdin and written to stdout.
"""
import re
import subprocess
import sys

FENCE_RE = re.compile(
    r"(?P<before>^(?P<indent> *)```(?P<lang>[a-zA-Z+#]+)\n)"
    r"(?P<code>.*?)"
    r"(?P<after>^(?P=indent)```\s*$)",
    re.DOTALL | re.MULTILINE,
)

FORMATTERS = {
    "python": ["black", "-q", "-"],
    "py": ["black", "-q", "-"],
    "javascript": ["prettier", "--parser", "babel"],
    "js": ["prettier", "--parser", "babel"],
    "jsx": ["prettier", "--parser", "babel"],
    "typescript": ["prettier", "--parser", "typescript"],
    "ts": ["prettier", "--parser", "typescript"],
    "tsx": ["prettier", "--parser", "typescript"],
    "bash": ["shfmt"],
    "sh": ["shfmt"],
    "shell": ["shfmt"],
    "rust": ["rustfmt", "--emit", "stdout"],
    "rs": ["rustfmt", "--emit", "stdout"],
    "go": ["gofmt"],
}


def format_code(lang: str, code: str) -> str:
    cmd = FORMATTERS.get(lang.lower())
    if cmd is None:
        return code
    try:
        result = subprocess.run(
            cmd, input=code, capture_output=True, text=True, check=True
        )
    except (subprocess.CalledProcessError, FileNotFoundError):
        return code
    return result.stdout


def process(text: str) -> str:
    def repl(m: re.Match) -> str:
        lang = m.group("lang")
        indent = m.group("indent")
        code = m.group("code")
        formatted = format_code(lang, code)
        if not formatted.endswith("\n"):
            formatted += "\n"
        if indent:
            formatted = "\n".join(
                indent + line if line else line
                for line in formatted.splitlines()
            ) + "\n"
        return m.group("before") + formatted + m.group("after")

    return FENCE_RE.sub(repl, text)


def main(argv: list[str]) -> int:
    if not argv:
        print("usage: mdcodefmt <file.md> [...]", file=sys.stderr)
        return 2

    changed = False
    for path in argv:
        with open(path, "r") as f:
            original = f.read()
        updated = process(original)
        if updated != original:
            with open(path, "w") as f:
                f.write(updated)
            changed = True

    return 1 if changed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
